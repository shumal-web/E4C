<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_e4c_common_styles">
        <style>
            .e4c-doc {
                font-family: Arial, sans-serif;
                color: #000;
                font-size: 12px;
            }
            .e4c-form-header {
                width: 100%;
                border-collapse: collapse;
                margin: 0 0 34px 0;
            }
            .e4c-form-header td {
                border: 0;
                vertical-align: top;
                padding: 0;
            }
            .e4c-logo-cell {
                width: 25%;
                text-align: left;
            }
            .e4c-logo {
                width: 60px;
                height: auto;
            }
            .e4c-title-cell {
                width: 50%;
                text-align: center;
                font-weight: 700;
            }
            .e4c-main-title {
                font-size: 18px;
                line-height: 1.2;
                margin: 0 0 10px 0;
            }
            .e4c-subtitle {
                font-size: 18px;
                line-height: 1.2;
                margin: 0;
                text-transform: none;
            }
            .e4c-address-cell {
                width: 25%;
                text-align: right;
                font-size: 12px;
                line-height: 1.5;
                font-weight: 700;
            }
            .e4c-top-layout {
                width: 100%;
                border-collapse: collapse;
                margin-top: 18px;
                margin-bottom: 38px;
            }
            .e4c-top-layout td {
                border: 0;
                padding: 0;
                vertical-align: top;
            }
            .e4c-top-left {
                width: 35%;
            }
            .e4c-top-gap {
                width: 16%;
            }
            .e4c-top-right {
                width: 49%;
            }
            .e4c-top-table,
            .e4c-line-table,
            .e4c-inventory-grid,
            .e4c-bol-table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
            }
            .e4c-top-table td {
                border: 1px solid #000;
                padding: 7px 8px;
                height: 26px;
                vertical-align: middle;
                font-size: 14px;
            }
            .e4c-top-table .e4c-warehouse-cell {
                height: 54px;
                text-align: center;
            }
            .e4c-line-table th,
            .e4c-line-table td {
                border: 1px solid #000;
                padding: 5px 5px;
                vertical-align: middle;
                font-size: 12px;
            }
            .e4c-line-table th {
                font-weight: 700;
                text-align: left;
                background: #fff;
            }
            .e4c-line-table td:first-child,
            .e4c-line-table th:first-child {
                text-align: center;
                font-weight: 700;
            }
            .e4c-comments-title {
                text-align: center;
                font-weight: 700;
                padding: 3px 5px !important;
            }
            .e4c-comments-box {
                height: 72px;
                vertical-align: top !important;
                white-space: pre-line;
                text-align: left !important;
                font-weight: 400 !important;
            }
            .e4c-signature-row {
                width: 100%;
                border-collapse: collapse;
                margin-top: 34px;
            }
            .e4c-signature-row td {
                border: 0;
                padding: 0;
                vertical-align: top;
                font-size: 12px;
            }
            .e4c-signature-line {
                border-top: 2px solid #000;
                height: 7px;
                width: 255px;
                margin-bottom: 3px;
            }
            .e4c-small {
                font-size: 10px;
            }
            .e4c-inventory-grid {
                margin-top: 24px;
                font-size: 12px;
            }
            .e4c-inventory-grid th,
            .e4c-inventory-grid td {
                border: 1px solid #000;
                padding: 7px 5px;
                vertical-align: middle;
                text-align: left;
                height: 28px;
            }
            .e4c-inventory-title {
                text-align: center !important;
                font-size: 14px;
                font-weight: 700;
            }
            .e4c-inventory-note {
                text-align: center !important;
                font-size: 13px;
                letter-spacing: 1px;
                font-weight: 700;
            }
            .e4c-bol {
                font-family: Arial, sans-serif;
                color: #000;
                font-size: 10px;
                border: 1px solid #000;
                min-height: 945px;
            }
            .e4c-bol-title {
                text-align: center;
                font-size: 18px;
                font-weight: 700;
                padding: 6px 4px;
                border-bottom: 1px solid #000;
            }
            .e4c-bol-table th,
            .e4c-bol-table td {
                border: 1px solid #000;
                padding: 4px 6px;
                vertical-align: top;
            }
            .e4c-bol-table th {
                text-align: left;
                font-weight: 700;
            }
            .e4c-bol-top td {
                height: 76px;
                font-size: 12px;
            }
            .e4c-bol-party td {
                height: 44px;
                font-size: 11px;
            }
            .e4c-bol-lines th {
                background: #4d4d4d;
                color: #fff;
                text-align: center;
                font-size: 11px;
                padding: 7px 5px;
            }
            .e4c-bol-lines td {
                height: 18px;
                font-size: 10px;
            }
            .e4c-bol-note {
                font-size: 7px;
                line-height: 1.2;
                padding: 4px 6px;
                border-top: 1px solid #000;
            }
            .e4c-bol-red {
                color: #d00;
                font-size: 12px;
                font-weight: 700;
                border-top: 1px solid #000;
                padding: 6px;
            }
            .e4c-bol-signature-table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
            }
            .e4c-bol-signature-table td {
                border: 1px solid #000;
                padding: 5px 8px;
                height: 22px;
                font-size: 13px;
            }
            .e4c-bol-footer {
                text-align: center;
                color: #d00;
                font-size: 18px;
                font-weight: 700;
                margin-top: 8px;
            }
            .e4c-terms {
                white-space: pre-line;
                font-size: 8px;
                line-height: 1.25;
                columns: 3;
                column-gap: 14px;
            }
            .e4c-label-page {
                font-family: Arial, sans-serif;
                color: #111;
                padding: 5mm;
                height: 141mm;
                box-sizing: border-box;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }
            .e4c-label-main {
                font-size: 28px;
                font-weight: 700;
                text-align: center;
                margin-bottom: 7mm;
            }
            .e4c-label-row {
                font-size: 17px;
                margin: 3mm 0;
                line-height: 1.25;
            }
            .e4c-label-key {
                font-weight: 700;
            }
            .e4c-label-piece {
                font-size: 25px;
                font-weight: 700;
                text-align: center;
                margin-top: 8mm;
                letter-spacing: 1px;
            }
        </style>
    </template>

    <template id="report_e4c_form_header">
        <table class="e4c-form-header">
            <tr>
                <td class="e4c-logo-cell">
                    <img class="e4c-logo" src="data:image/png;base64,"/>
                </td>
                <td class="e4c-title-cell">
                    <div class="e4c-main-title">Job Information Sheet</div>
                    <div class="e4c-subtitle"><span t-out="subtitle"/></div>
                </td>
                <td class="e4c-address-cell">
                    795 George V Avenue,<br/>
                    Lachine, QC, H8S 2R9
                </td>
            </tr>
        </table>
    </template>

    <template id="report_e4c_piece_table">
        <t t-set="lines" t-value="doc._e4c_report_line_values()"/>
        <table class="e4c-line-table">
            <thead>
                <tr>
                    <th style="width: 6%;">#of<br/>Pieces</th>
                    <th style="width: 18%;">Description of Pieces</th>
                    <th style="width: 21%;">Dimension(L x W x H)</th>
                    <th style="width: 14%;">Weight</th>
                    <th style="width: 8%;">Location</th>
                    <th style="width: 6%;">#of<br/>Pieces</th>
                    <th style="width: 8%;">Pictures</th>
                    <th style="width: 12%;">Condition of<br/>the Pieces</th>
                    <th style="width: 7%;">Initials</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="lines" t-as="line">
                    <td><span t-out="line.get('quantity')"/></td>
                    <td><span t-out="line.get('description')"/></td>
                    <td><span t-out="line.get('dimensions')"/></td>
                    <td><span t-out="line.get('weight')"/></td>
                    <td><span t-out="line.get('location')"/></td>
                    <td></td>
                    <td><span t-out="line.get('pictures')"/></td>
                    <td><span t-out="line.get('condition')"/></td>
                    <td></td>
                </tr>
                <tr t-if="not lines">
                    <td colspan="9" style="height: 30px; text-align:left; font-weight:400;">No lines found.</td>
                </tr>
                <tr>
                    <td colspan="9" class="e4c-comments-title">Comments</td>
                </tr>
                <tr>
                    <td colspan="9" class="e4c-comments-box">Please confirm dimensions, piece counts and identifying marks.<t t-if="doc._e4c_report_special_instructions()"><br/>Special Instructions: <span t-out="doc._e4c_report_special_instructions()"/></t><t t-if="doc._e4c_report_tags()"><br/>Tags: <span t-out="doc._e4c_report_tags()"/></t></td>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="report_e4c_signature_lines">
        <table class="e4c-signature-row">
            <tr>
                <td style="width: 50%;">
                    <div class="e4c-signature-line"></div>
                    Pictures and Report sent to Office
                </td>
                <td style="width: 50%;">
                    <div class="e4c-signature-line"></div>
                    Employee Signature
                </td>
            </tr>
        </table>
    </template>

    <template id="report_e4c_truck_sheet_body">
        <div class="page e4c-doc">
            <t t-call="tf_e4c_printouts.report_e4c_common_styles"/>
            <t t-set="subtitle" t-value="'Truck Sheet'"/>
            <t t-call="tf_e4c_printouts.report_e4c_form_header"/>

            <table class="e4c-top-layout">
                <tr>
                    <td class="e4c-top-left">
                        <table class="e4c-top-table">
                            <tr>
                                <td class="e4c-warehouse-cell" style="width:45%;">Warehouse</td>
                                <td class="e4c-warehouse-cell">795</td>
                            </tr>
                            <tr>
                                <td>E4C File:</td>
                                <td><span t-out="doc.name"/></td>
                            </tr>
                            <tr>
                                <td>Date:</td>
                                <td><span t-out="doc._e4c_report_date()"/></td>
                            </tr>
                            <tr>
                                <td>Carrier:</td>
                                <td><span t-out="doc._e4c_report_carrier()"/></td>
                            </tr>
                            <tr>
                                <td>Customer:</td>
                                <td><span t-out="doc._e4c_report_customer_name()"/></td>
                            </tr>
                            <tr>
                                <td>Customer PO:</td>
                                <td><span t-out="doc._e4c_report_customer_reference()"/></td>
                            </tr>
                        </table>
                    </td>
                    <td class="e4c-top-gap"></td>
                    <td class="e4c-top-right">
                        <table class="e4c-top-table">
                            <tr>
                                <td style="width:58%;">Job done by:</td>
                                <td><span t-out="doc._e4c_report_driver()"/></td>
                            </tr>
                            <tr>
                                <td>IN/OUT:</td>
                                <td><span t-out="sheet_direction"/></td>
                            </tr>
                            <tr>
                                <td>Warehouse Location:</td>
                                <td><span t-out="doc._e4c_report_destination_location() if sheet_direction == 'Out' else doc._e4c_report_source_location()"/></td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <t t-call="tf_e4c_printouts.report_e4c_piece_table"/>
            <t t-call="tf_e4c_printouts.report_e4c_signature_lines"/>
        </div>
    </template>

    <template id="report_e4c_truck_in_sheet">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
                <t t-set="sheet_direction" t-value="'In'"/>
                <t t-call="tf_e4c_printouts.report_e4c_truck_sheet_body"/>
            </t>
        </t>
    </template>

    <template id="report_e4c_truck_out_sheet_picking">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
                <t t-set="sheet_direction" t-value="'Out'"/>
                <t t-call="tf_e4c_printouts.report_e4c_truck_sheet_body"/>
            </t>
        </t>
    </template>

    <template id="report_e4c_dispatch_truck_out_sheet">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
                <t t-set="sheet_direction" t-value="'Out'"/>
                <t t-call="tf_e4c_printouts.report_e4c_truck_sheet_body"/>
            </t>
        </t>
    </template>


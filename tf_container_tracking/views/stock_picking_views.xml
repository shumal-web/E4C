<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_tf_sale_order_link" model="ir.ui.view">
        <field name="name">stock.picking.form.tf.sale.order.link</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="tf_serial_quote_attributes.view_picking_form_tf_fields"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_tf_truck_out"
                        type="object"
                        string="Truck Out"
                        class="btn-secondary"
                        invisible="state != 'done' or not tf_container_plan_id or picking_type_code != 'incoming'"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_tf_load_documents"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not tf_sale_order_id">
                    <field name="tf_load_document_count" string="Documents" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="tf_sale_order_id"
                       options="{'no_create': True}"
                       readonly="state in ['cancel', 'done']"/>
                <field name="tf_customer_reference" readonly="1"/>
                <field name="tf_container_number" readonly="1"/>
                <field name="tf_container_serial_number" readonly="1"/>
                <field name="tf_flow_kind" readonly="1"/>
                <field name="tf_shipper_partner_id" readonly="1"/>
                <field name="tf_shipper_note" widget="text" readonly="1"/>
                <field name="tf_consignee_partner_id" readonly="1"/>
                <field name="tf_consignee_note" widget="text" readonly="1"/>
                <field name="tf_address_note" widget="text" readonly="1" invisible="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="tf_load_documents" string="Documents">
                    <field name="tf_load_document_ids"
                           context="{'default_sale_order_id': tf_sale_order_id, 'default_picking_id': id}">
                        <list string="Load Documents" editable="bottom">
                            <button name="action_download_file" type="object" string="Download" icon="fa-download"/>
                <field name="file_name" string="File Name"/>
                <field name="file_data" widget="binary" filename="file_name" optional="hide"/>
                <field name="attachment_id" readonly="1" optional="hide"/>
                            <field name="document_type"/>
                            <field name="source" readonly="1"/>
                            <field name="container_plan_id" optional="hide"/>
                            <field name="dispatch_ticket_id" optional="hide"/>
                            <field name="picking_id" optional="show"/>
                            <field name="uploaded_by_id" readonly="1"/>
                            <field name="uploaded_on" readonly="1"/>
                            <field name="comment"/>
                        </list>
                        <form string="Load Document">
                            <group>
                                <group>
                                    <field name="document_type"/>
                                    <button name="action_download_file" type="object" string="Download" class="btn-primary"/>
                                    <field name="file_name"/>
                                    <field name="file_data" widget="binary" filename="file_name"/>
                                    <field name="attachment_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="source" readonly="1"/>
                                    <field name="uploaded_by_id" readonly="1"/>
                                    <field name="uploaded_on" readonly="1"/>
                                    <field name="container_plan_id"/>
                                    <field name="dispatch_ticket_id"/>
                                    <field name="picking_id"/>
                                </group>
                            </group>
                            <group>
                                <field name="comment" placeholder="Add a note about this file..."/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
            <xpath expr="//chatter" position="attributes">
                <attribute name="open_attachments">True</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_picking_list_tf_sale_order_link" model="ir.ui.view">
        <field name="name">stock.picking.list.tf.sale.order.link</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="tf_sale_order_id" optional="show"/>
                <field name="tf_customer_reference" optional="hide"/>
                <field name="tf_container_number" optional="show"/>
                <field name="tf_container_serial_number" optional="show"/>
                <field name="tf_flow_kind" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_internal_search_tf_receiving_label" model="ir.ui.view">
        <field name="name">stock.picking.search.tf.receiving.label</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='reception']" position="attributes">
                <attribute name="string">Receiving</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_tf_inventory_documents" model="ir.actions.act_window">
        <field name="name">Inventory Documents</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('tf_sale_order_id', '!=', False)]</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_tf_inventory_documents"
              name="Inventory Documents"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_tf_inventory_documents"
              sequence="92"/>
</odoo>

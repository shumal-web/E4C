<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tf_container_bulk_update_wizard_form" model="ir.ui.view">
        <field name="name">tf.container.bulk.update.wizard.form</field>
        <field name="model">tf.container.bulk.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Update Containers">
                <group>
                    <field name="tf_internal_status"/>
                    <field name="tf_container_status"/>
                    <field name="tf_eta"/>
                    <field name="tf_lfd"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

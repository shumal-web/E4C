<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock.menu_stock_root" model="ir.ui.menu">
        <field name="name">Operations</field>
    </record>

    <record id="stock.in_picking" model="ir.ui.menu">
        <field name="name">Receiving</field>
    </record>

    <record id="stock.action_picking_tree_incoming" model="ir.actions.act_window">
        <field name="name">Receiving</field>
    </record>

    <record id="stock.menu_action_inventory_tree" model="ir.ui.menu">
        <field name="active" eval="False"/>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_no_one')])]"/>
    </record>

    <record id="stock.menu_stock_scrap" model="ir.ui.menu">
        <field name="active" eval="False"/>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_no_one')])]"/>
    </record>

    <record id="stock.menu_reordering_rules_replenish" model="ir.ui.menu">
        <field name="active" eval="False"/>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_no_one')])]"/>
    </record>

    <record id="stock.menu_procurement_compute" model="ir.ui.menu">
        <field name="active" eval="False"/>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_no_one')])]"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_tf_special_instructions" inherit_id="sale.report_saleorder_document">
        <xpath expr="//span[@name='order_note']" position="before">
            <div t-if="doc.tf_special_instructions" class="mt-3 mb-2">
                <strong>Special Instructions:</strong>
                <div style="white-space: pre-line;" t-out="doc.tf_special_instructions"/>
            </div>
        </xpath>
    </template>
</odoo>

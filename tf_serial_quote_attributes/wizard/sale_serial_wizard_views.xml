<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tf_sale_serial_wizard_form" model="ir.ui.view">
        <field name="name">tf.sale.serial.wizard.form</field>
        <field name="model">tf.sale.serial.wizard</field>
        <field name="arch" type="xml">
            <form string="Serial Details">
                <group>
                    <field name="order_line_id" invisible="1"/>
                    <field name="order_id" readonly="1"/>
                    <field name="product_id" readonly="1"/>
                    <field name="qty" readonly="1"/>
                </group>

                <field name="line_ids">
                    <!-- Odoo 19: use <list>, not <tree> -->
                    <list editable="bottom">
                        <field name="sequence"/>
                        <field name="serial_name"/>
                        <field name="tf_description"/>
                        <field name="tf_length"/>
                        <field name="tf_width"/>
                        <field name="tf_height"/>
                        <field name="tf_dimension_unit"/>
                        <field name="tf_weight"/>
                        <field name="tf_weight_unit"/>
                        <field name="tf_storage_rate"/>
                        <field name="tf_location_note"/>
                    </list>
                </field>

                <footer>
                    <button name="action_generate_serials" type="object" string="Generate Serials" class="btn-primary"/>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_form_tf_fields" model="ir.ui.view">
        <field name="name">stock.lot.form.tf.fields</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//group" position="inside">
                <group string="Storage Attributes">
                    <field name="tf_description"/>
                    <field name="tf_length"/>
                    <field name="tf_width"/>
                    <field name="tf_height"/>
                    <field name="tf_dimension_unit"/>
                    <field name="tf_weight"/>
                    <field name="tf_weight_unit"/>
                    <field name="tf_storage_rate"/>
                    <field name="tf_location_note"/>
                </group>
                <group string="Dates / Counter">
                    <field name="tf_reception_date"/>
                    <field name="tf_delivery_date"/>
                    <field name="tf_day_counter" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
